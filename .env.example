# Florence Guide Management System - Environment Configuration
# Copy this file to .env.local and update the values for your environment
# NEVER commit .env.local to version control

# =====================================================
# Database Configuration
# =====================================================
DB_HOST=localhost
DB_NAME=florence_guides
DB_USER=root
DB_PASS=

# =====================================================
# Bokun API Configuration
# =====================================================
# Your Bokun vendor ID (found in Bokun dashboard)
BOKUN_VENDOR_ID=your_vendor_id

# API Key from Bokun API settings
BOKUN_API_KEY=your_api_key_here

# API Secret from Bokun API settings
BOKUN_API_SECRET=your_api_secret_here

# Bokun API base URL
BOKUN_BASE_URL=https://api.bokun.is

# =====================================================
# Application Settings
# =====================================================
# Environment: development or production
APP_ENV=development

# Debug mode: true enables detailed error messages
APP_DEBUG=true

# Staging / ops switches (step 0.1)
# BOKUN_SYNC_ENABLED=false -> every sync path (timer, manual, webhook, cron) returns {success:false, error:'sync_disabled'}. Staging default.
# TWILIO_DRY_RUN=true      -> no HTTP call to Twilio; intended action written to guide_reminders.last_error as "DRY RUN: ...". Staging default.
BOKUN_SYNC_ENABLED=true

# Step 2.4: per-request Bokun API lines and per-booking "Rescheduling detected" lines in the
# error log only when true (~80 KB per sync). Errors and the per-sync summary are always logged.
BOKUN_DEBUG_LOG=false
TWILIO_DRY_RUN=false
# Step 3.10: the evening guide digest (ONE WhatsApp per guide at 21:30 Europe/Rome listing
# that guide's departures for the next day; replaces the ~60-min-before per-tour reminder).
# DIGEST_LIVE is the hard safety gate and defaults to FALSE: while it is false the sender
# refuses every destination except DIGEST_TEST_NUMBER - it makes no Twilio call at all for
# anyone else. Flip it to true only after the owner has approved a preview and a test send.
TWILIO_DIGEST_ENABLED=true
DIGEST_LIVE=false
# Content SID (HX...) of the approved WhatsApp template guide_daily_digest_it. Never in git.
TWILIO_DIGEST_CONTENT_SID=
# The only number that may be messaged while DIGEST_LIVE=false (E.164, e.g. +39...).
DIGEST_TEST_NUMBER=
# Separator between the tour lines inside template variable {{3}}. Default is a newline;
# set it to " | " if WhatsApp rejects newlines inside a template parameter.
# DIGEST_LINE_SEPARATOR=

# Shared secret for the Bokun webhook (step 1.4): the URL registered in Bokun is /api/bokun_webhook.php?key=<this>. Empty = webhook answers 503.
WEBHOOK_SECRET=

# Base URL for the application
APP_URL=http://localhost:5173

# API URL (backend endpoint)
API_URL=http://localhost:8080/api

# =====================================================
# Security Settings
# =====================================================
# Session lifetime in seconds (default: 24 hours)
SESSION_LIFETIME=86400

# PHP error log directory (step 2.1). Must be OUTSIDE the web root. Empty = <home>/logs
# (files api-error.log for production, api-error-staging.log / api-error-development.log otherwise).
FWL_LOG_DIR=

# Trusted reverse proxies (step 1.3). Comma-separated list of REMOTE_ADDR values that are
# allowed to set the real client IP via CF-Connecting-IP / X-Forwarded-For / X-Real-IP.
# Empty (default) = the rate limiter uses REMOTE_ADDR only and ignores those headers.
TRUSTED_PROXIES=

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Encryption key for sensitive data (REQUIRED for Bokun API credentials)
# Generate with: php -r "echo base64_encode(random_bytes(32));"
# Or: openssl rand -base64 32
# IMPORTANT: Keep this key safe! Losing it means losing access to encrypted data.
ENCRYPTION_KEY=

# =====================================================
# Sentry Error Tracking (Backend)
# =====================================================
# Sentry DSN from your Sentry project settings
# Format: https://{public_key}@{host}/{project_id}
SENTRY_DSN=

# Environment name for Sentry (development, staging, production)
SENTRY_ENVIRONMENT=production

# Optional: Release version for tracking deployments
# SENTRY_RELEASE=florence-guides@1.0.0

# =====================================================
# Production Configuration Example
# =====================================================
# For production deployment, use these values:
#
# DB_HOST=localhost
# DB_NAME=your_hostinger_db_name
# DB_USER=your_hostinger_db_user
# DB_PASS=your_production_password
#
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://withlocals.deetech.cc
# API_URL=https://withlocals.deetech.cc/api
#
# CORS_ALLOWED_ORIGINS=https://withlocals.deetech.cc
