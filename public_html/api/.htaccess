# Florence with Locals - API folder .htaccess (step 2.3: rewrites + deny rules ONLY).
# Security headers, HSTS, compression and static caching come from the site
# .htaccess one level up (inherited here); API responses get Cache-Control: no-store
# from config.php. Nothing is set twice.

# ===========================================================================
# DENY (step 0.2): never serve env files, logs, dumps, docs, the release marker
# or maintenance/test scripts - even if a stray copy lands in this folder.
# Web-facing PHP endpoints are unaffected. bokun_cron.php is CLI/cron only.
# ===========================================================================
<FilesMatch "^(\.env.*|.*\.(log|sql|md|json|txt|bak|backup)(\..*|-.*)?|error_log|VERSION|(debug|test|check|fix|migrate)_.*\.php|.*_test\.php|bokun_cron\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ===========================================================================
# URL REWRITING
# ===========================================================================
RewriteEngine On
RewriteBase /api/

# tests/ is never web-served (step 0.2)
RewriteRule ^tests(/.*)?$ - [F,L]

# Allow direct access to existing files and directories
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# CORS is handled by PHP (config.php) with environment-aware origin checking.
# Do NOT set Access-Control-Allow-Origin here - it would override PHP's logic.

# Handle OPTIONS method for CORS preflight requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Route for tours paid/cancelled status update
RewriteRule ^tours/([0-9]+)/paid$ tours.php [QSA,L]
RewriteRule ^tours/([0-9]+)/cancelled$ tours.php [QSA,L]

# Catch-all: route all other requests to index.php (RESTful API routing)
RewriteRule ^(.*)$ index.php [QSA,L]

# Handle 404s
ErrorDocument 404 /api/404.php